{
  "name": "shinycard",
  "version": "0.1.1",
  "description": "An interactive holographic card component for Vue 3.",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/shinycard.js",
  "module": "./dist/shinycard.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/shinycard.js",
      "default": "./dist/shinycard.js"
    },
    "./style.css": "./dist/style.css"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && npm run build:js && npm run build:types",
    "preview": "vite preview",
    "build:js": "vite build",
    "build:types": "vue-tsc --project tsconfig.lib.json --declaration --emitDeclarationOnly",
    "type-check": "vue-tsc --build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "sass": "^1.93.2",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
